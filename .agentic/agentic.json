{
  "schemaVersion": 4,
  "orchestration": "runtime-native",
  "runtimes": {
    "claudeCode": {
      "mode": "ultracode",
      "executionEngine": "dynamic-workflows",
      "customAgents": "fallback"
    },
    "codex": {
      "reasoningEffort": "ultra",
      "executionEngine": "proactive-multi-agent",
      "customAgents": "fallback"
    }
  },
  "context": {
    "durableTaskState": "engineering-only",
    "rootSessionRole": "control-plane",
    "runtimeState": "runtime-native",
    "manualClearRequired": false,
    "autoCompaction": "runtime-native",
    "keepMainThreadLean": true
  },
  "parallelism": {
    "mode": "runtime-native",
    "parallelWritesRequireIsolatedCheckout": true,
    "sameCheckoutMultipleWriters": false
  },
  "pullRequests": {
    "provider": "github-native",
    "topology": "agentic-policy",
    "stackedPullRequests": "auto",
    "submission": "when-task-intent-allows"
  },
  "longTasks": {
    "stateDirectory": ".agent/tasks",
    "activeTaskFile": ".agent/ACTIVE_TASK",
    "persistRuntimeAgentGraph": false
  },
  "projectDiscovery": {
    "mode": "auto",
    "profile": ".agentic/PROJECT.md",
    "staleMarker": ".agentic/PROFILE_STALE"
  },
  "dependencies": {
    "policy": "latest-stable-compatible",
    "lockfiles": "required-when-supported",
    "githubActions": "latest-stable-sha-pinned",
    "updates": "dependabot"
  },
  "methodologies": {
    "superpowers": {
      "mode": "compatible-if-installed",
      "role": "methodology-provider",
      "executionTopology": "runtime-native",
      "nestedSchedulers": false,
      "deduplicate": [
        "code-review",
        "verification",
        "worktree-setup"
      ]
    }
  }
}
